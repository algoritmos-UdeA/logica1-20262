<mxfile host="drawio"><diagram id="modulos_poo" name="modulos_poo"><mxGraphModel grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="modulos_poo-1" value="&lt;b&gt;main.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;N = 10&amp;nbsp;&amp;nbsp;(el cupo)&lt;br&gt;mostrar_menu()&lt;br&gt;main()&amp;nbsp;&amp;nbsp;(el menú):&lt;br&gt;&amp;nbsp;&amp;nbsp;crea el Curso y los Estudiante&lt;br&gt;if __name__ == &amp;quot;__main__&amp;quot;: ..." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fontFamily=Consolas, monospace;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="150" width="320" height="150" as="geometry"/></mxCell><mxCell id="modulos_poo-2" value="&lt;b&gt;test_curso.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;assert …&lt;br&gt;print(&amp;quot;Pruebas de curso: …&amp;quot;)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fontFamily=Consolas, monospace;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="940" y="230" width="320" height="100" as="geometry"/></mxCell><mxCell id="modulos_poo-3" value="&lt;b&gt;test_estudiante.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;assert …&lt;br&gt;print(&amp;quot;Pruebas de estudiante: …&amp;quot;)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fontFamily=Consolas, monospace;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="380" width="320" height="100" as="geometry"/></mxCell><mxCell id="modulos_poo-4" value="&lt;b&gt;curso.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;class Curso:&lt;br&gt;&amp;nbsp;&amp;nbsp;__init__(cupo)&lt;br&gt;&amp;nbsp;&amp;nbsp;get_cantidad, get_estudiante&lt;br&gt;&amp;nbsp;&amp;nbsp;buscar_id&lt;br&gt;&amp;nbsp;&amp;nbsp;agregar_estudiante&lt;br&gt;&amp;nbsp;&amp;nbsp;eliminar_estudiante&lt;br&gt;&amp;nbsp;&amp;nbsp;actualizar_nota&lt;br&gt;&amp;nbsp;&amp;nbsp;mostrar_listado&lt;br&gt;&amp;nbsp;&amp;nbsp;posicion_mayor_nota, ordenar_por_nota&lt;br&gt;&amp;nbsp;&amp;nbsp;posicion_menor_nombre, ordenar_por_nombre" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fontFamily=Consolas, monospace;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="440" y="0" width="400" height="270" as="geometry"/></mxCell><mxCell id="modulos_poo-5" value="&lt;b&gt;estudiante.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;class Estudiante:&lt;br&gt;&amp;nbsp;&amp;nbsp;NOTA_MINIMA, NOTA_MAXIMA&lt;br&gt;&amp;nbsp;&amp;nbsp;__init__(id, nombre, nota)&lt;br&gt;&amp;nbsp;&amp;nbsp;get_id, get_nombre, get_nota&lt;br&gt;&amp;nbsp;&amp;nbsp;set_nota&lt;br&gt;&amp;nbsp;&amp;nbsp;__str__" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fontFamily=Consolas, monospace;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="440" y="330" width="400" height="170" as="geometry"/></mxCell><mxCell id="modulos_poo-6" value="&lt;b&gt;ordenamientos.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;intercambiar(lista, i, j)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fontFamily=Consolas, monospace;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="940" y="40" width="320" height="80" as="geometry"/></mxCell><mxCell id="modulos_poo-7" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#6C8EBF;dashed=1;" edge="1" parent="1" source="modulos_poo-1" target="modulos_poo-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="modulos_poo-8" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#6C8EBF;dashed=1;" edge="1" pa