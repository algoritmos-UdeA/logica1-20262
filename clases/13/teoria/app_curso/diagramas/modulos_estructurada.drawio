<mxfile host="drawio"><diagram id="modulos_estructurada" name="modulos_estructurada"><mxGraphModel grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="modulos_estructurada-1" value="&lt;b&gt;main.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;N = 10&amp;nbsp;&amp;nbsp;(el cupo)&lt;br&gt;mostrar_menu()&lt;br&gt;main()&amp;nbsp;&amp;nbsp;(el menú)&lt;br&gt;if __name__ == &amp;quot;__main__&amp;quot;: ..." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fontFamily=Consolas, monospace;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="300" height="125" as="geometry"/></mxCell><mxCell id="modulos_estructurada-2" value="&lt;b&gt;test_curso.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;assert …&lt;br&gt;print(&amp;quot;Pruebas de curso: …&amp;quot;)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fontFamily=Consolas, monospace;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="170" width="300" height="100" as="geometry"/></mxCell><mxCell id="modulos_estructurada-3" value="&lt;b&gt;curso.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;buscar_id&lt;br&gt;agregar_estudiante&lt;br&gt;eliminar_estudiante&lt;br&gt;actualizar_nota&lt;br&gt;mostrar_listado&lt;br&gt;ordenar_por_nota&lt;br&gt;ordenar_por_nombre&lt;br&gt;&lt;br&gt;&lt;i&gt;de apoyo:&lt;/i&gt;&lt;br&gt;intercambiar_estudiantes&lt;br&gt;posicion_mayor_nota&lt;br&gt;posicion_menor_nombre" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fontFamily=Consolas, monospace;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="380" y="0" width="360" height="270" as="geometry"/></mxCell><mxCell id="modulos_estructurada-4" value="&lt;b&gt;ordenamientos.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;intercambiar&amp;nbsp;&amp;nbsp;← la que usa curso.py&lt;br&gt;&lt;span style=&quot;color:#888888&quot;&gt;posicion_menor, ordenar_…&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fontFamily=Consolas, monospace;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="820" y="90" width="300" height="90" as="geometry"/></mxCell><mxCell id="modulos_estructurada-5" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#6C8EBF;dashed=1;" edge="1" parent="1" source="modulos_estructurada-1" target="modulos_estructurada-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="modulos_estructurada-6" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#6C8EBF;dashed=1;" edge="1" parent="1" source="modulos_estructurada-2" target="modulos_estructurada-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="modulos_estructurada-7" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#6C8EBF;dashed=1;" edge="1" parent="1" source="modulos_estructurada-3" target="modulos_estructurada-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="modulos_estructurada-8" value="Flechas punteadas: import (el archivo de donde sale la flecha importa al otro)." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="0" y="290" width="1120" height="24" as="geometry"/></mxCell><mxCell id="modulos_estructurada-9" value="Los datos viajan como parámetros: ids, nombres, notas y cantidad." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="0" y="316" width="1120" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>