<mxfile host="drawio"><diagram id="uml_list" name="uml_list"><mxGraphModel grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="uml_list-1" value="list" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Consolas, monospace;fontSize=14;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="293" height="35" as="geometry"/></mxCell><mxCell id="uml_list-2" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Consolas, monospace;fontSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="35" width="293" height="224" as="geometry"/></mxCell><mxCell id="uml_list-3" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Consolas, monospace;fontSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="259" width="293" height="68" as="geometry"/></mxCell><mxCell id="uml_list-4" value="+&amp;nbsp;list()" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Consolas, monospace;fontSize=14;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="10" y="43" width="281" height="26" as="geometry"/></mxCell><mxCell id="uml_list-5" value="Crea una lista vacía. También se crea con [ ]." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=2;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="309" y="43" width="640" height="26" as="geometry"/></mxCell><mxCell id="uml_list-6" value="+&amp;nbsp;append(elemento)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Consolas, monospace;fontSize=14;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="10" y="69" width="281" height="26" as="geometry"/></mxCell><mxCell id="uml_list-7" value="Agrega el elemento al final." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=2;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="309" y="69" width="640" height="26" as="geometry"/></mxCell><mxCell id="uml_list-8" value="+&amp;nbsp;insert(posicion:&amp;nbsp;int,&amp;nbsp;elemento)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Consolas, monospace;fontSize=14;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="10" y="95" width="281" height="26" as="geometry"/></mxCell><mxCell id="uml_list-9" value="Inserta el elemento en esa posición; los que siguen se corren." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=2;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="309" y="95" width="640" height="26" as="geometry"/></mxCell><mxCell id="uml_list-10" value="+&amp;nbsp;extend(otra:&amp;nbsp;list)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Consolas, monospace;fontSize=14;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="10" y="121" width="281" height="26" as="geometry"/></mxCell><mxCell id="uml_list-11" value="Agrega al final todos los elementos de otra lista." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=2;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="309" y="121" width="640" height="26" as="geometry"/></mxCell><mxCell id="uml_list-12" value="+&amp;nbsp;pop(posicion:&amp;nbsp;int)&amp;nbsp;:&amp;nbsp;elemento" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Consolas, monospace;fontSize=14;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="10" y="147" width="281" height="26" as="geometry"/></mxCell><mxCell id="uml_list-13" value="Quita el elemento de esa posición y lo retorna. Sin posición, quita el último." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=2;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="309" y="147" width="640" height="26" as="geometry"/></mxCell><mxCell id="uml_list-14" value="+&amp;nbsp;remove(elemento)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Consolas, monospace;fontSize=14;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="10" y="173" width="281" height="26" as="geometry"/></mxCell><mxCell id="uml_list-15" value="Quita la primera aparición del elemento." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=2;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="309" y="173" width="640" height="26" as="geometry"/></mxCell><mxCell id="uml_list-16" value="+&amp;nbsp;sort()" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Consolas, monospace;fontSize=14;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="10" y="199" width="281" height="26" as="geometry"/></mxCell><mxCell id="uml_list-17" value="Ordena los elementos de menor a mayor." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=2;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="309" y="199" width="640" height="26" as="geometry"/></mxCell><mxCell id="uml_list-18" value="+&amp;nbsp;reverse()" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Consolas, monospace;fontSize=14;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="10" y="225" width="281" height="26" as="geometry"/></mxCell><mxCell id="uml_list-19" value="Invierte el orden de los elementos." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=2;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="309" y="225" width="640" height="26" as="geometry"/></mxCell><mxCell id="uml_list-20" value="+&amp;nbsp;index(elemento)&amp;nbsp;:&amp;nbsp;int" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Consolas, monospace;fontSize=14;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="10" y="267" width="281" height="26" as="geometry"/></mxCell><mxCell id="uml_list-21" value="Retorna la posición de la primera aparición del elemento." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=2;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="309" y="267" width="640" height="26" as="geometry"/></mxCell><mxCell id="uml_list-22" value="+&amp;nbsp;count(elemento)&amp;nbsp;:&amp;nbsp;int" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Consolas, monospace;fontSize=14;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="10" y="293" width="281" height="26" as="geometry"/></mxCell><mxCell id="uml_list-23" value="Retorna cuántas veces aparece el elemento." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=2;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="309" y="293" width="640" height="26" as="geometry"/></mxCell><mxCell id="uml_list-24" value="Lo que hace cada método" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="309" y="4" width="640" height="28" as="geometry"/></mxCell><mxCell id="uml_list-25" value="Los ocho primeros MODIFICAN la lista; los dos últimos solo la consultan. Los datos de la lista no aparecen: están ocultos, y solo se llega a ellos con sus métodos y operadores." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="0" y="335" width="953" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
