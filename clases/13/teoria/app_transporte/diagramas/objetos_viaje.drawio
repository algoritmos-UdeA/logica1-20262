cePoint"/><mxPoint x="880" y="265.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="objetos_viaje-36" value="El viaje no guarda copias del cliente ni del conductor: guarda referencias a los objetos que ya existían (lucia y cj). El origen y el destino, en cambio, son dos puntos nuevos que el viaje creó para sí mismo." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="0" y="590" width="1040" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
