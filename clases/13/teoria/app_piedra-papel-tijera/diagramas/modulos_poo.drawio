<mxfile host="drawio"><diagram id="modulos_poo" name="modulos_poo"><mxGraphModel grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="modulos_poo-1" value="&lt;b&gt;main.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;RONDAS_PARA_GANAR = 3&lt;br&gt;mostrar_menu()&lt;br&gt;leer_jugada()&lt;br&gt;main():&lt;br&gt;&amp;nbsp;&amp;nbsp;crea los dos Jugador y la Partida&lt;br&gt;if __name__ == &amp;quot;__main__&amp;quot;: ..." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fontFamily=Consolas, monospace;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="150" width="330" height="190" as="geometry"/></mxCell><mxCell id="modulos_poo-2" value="&lt;b&gt;partida.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;class Partida:&lt;br&gt;&amp;nbsp;&amp;nbsp;jugar_ronda, terminada,&lt;br&gt;&amp;nbsp;&amp;nbsp;get_ganador, __str__ ..." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fontFamily=Consolas, monospace;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="440" y="0" width="330" height="140" as="geometry"/></mxCell><mxCell id="modulos_poo-3" value="&lt;b&gt;ronda.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;class Ronda:&lt;br&gt;&amp;nbsp;&amp;nbsp;get_resultado, __str__ ..." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fontFamily=Consolas, monospace;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="440" y="190" width="330" height="120" as="geometry"/></mxCell><mxCell id="modulos_poo-4" value="&lt;b&gt;jugador.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;class Jugador:&lt;br&gt;&amp;nbsp;&amp;nbsp;sumar_punto, __str__ ..." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fontFamily=Consolas, monospace;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="440" y="360" width="330" height="120" as="geometry"/></mxCell><mxCell id="modulos_poo-5" value="&lt;b&gt;reglas.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;PIEDRA, PAPEL, TIJERA&lt;br&gt;EMPATE, GANA_USUARIO, GANA_MAQUINA&lt;br&gt;es_jugada_valida&lt;br&gt;nombre_jugada&lt;br&gt;definir_ganador&lt;br&gt;jugar_maquina" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fontFamily=Consolas, monospace;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="120" width="330" height="190" as="geometry"/></mxCell><mxCell id="modulos_poo-6" value="&lt;b&gt;test_jugador.py&lt;/b&gt;, &lt;b&gt;test_ronda.py&lt;/b&gt;,&lt;br&gt;&lt;b&gt;test_partida.py&lt;/b&gt;, &lt;b&gt;test_reglas.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;cada uno importa lo que prueba" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fontFamily=Consolas, monospace;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="360" width="330" height="120" as="geometry"/></mxCell><mxCell id="modulos_poo-7" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#6C8EBF;dashed=1;" edge="1" parent="1" source="modulos_poo-1" target="modulos_poo-2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="modulos_poo-8" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#6C8EBF;dashed=1;" edge="1" parent="1" source="modulos_poo-1" target="modulos_poo-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="modulos_poo-9" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#6C8EBF;dashed=1;" edge="1" parent="1" source="modulos_poo-2" target="modulos_poo-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="modulos_poo-10" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#6C8EBF;dashed=1;" edge="1" parent="1" source="modulos_poo-2" target="modulos_poo-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="modulos_poo-11" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#6C8EBF;dashed=1;" edge="1" parent="1" source="modulos_poo-3" target="modulos_poo-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="modulos_poo-12" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#6C8EBF;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="modulos_poo-1" target="modulos_poo-5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="165" y="-40"/><mxPoint x="1045" y="-40"/></Array></mxGeometry></mxCell><mxCell id="modulos_poo-13" value="Flechas punteadas: import (el archivo de donde sale la flecha importa al otro)." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="0" y="500" width="1210" height="24" as="geometry"/></mxCell><mxCell id="modulos_poo-14" value="partida.py importa ronda.py porque crea las rondas (composición), pero no importa jugador.py: recibe los jugadores ya creados (agregación)." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=2;fontColor=#555555;fontColor=#B85450;" vertex="1" parent="1"><mxGeometry x="0" y="526" width="1210" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>