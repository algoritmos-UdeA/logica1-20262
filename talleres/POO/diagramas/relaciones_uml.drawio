ngRight=4;" vertex="1" parent="1"><mxGeometry x="354" y="0" width="50" height="20" as="geometry"/></mxCell><mxCell id="relaciones-7" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Consolas;fontSize=13;fontStyle=0;fontColor=#000000;align=right;verticalAlign=middle;strokeWidth=1;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="520" y="0" width="36" height="20" as="geometry"/></mxCell><mxCell id="relaciones-8" value="&lt;b&gt;Un objeto conoce a otro y le pide cosas.&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot;&gt;procedimiento = Procedimiento(..., homero)&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;fontColor=#000000;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="720" y="-4" width="390" height="60" as="geometry"/></mxCell><mxCell id="relaciones-9" value="Composición" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#000000;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="150" height="50" as="geometry"/></mxCell><mxCell id="relaciones-10" value="ListaReproduccion" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Consolas;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;strokeWidth=2;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="150" y="90" width="200" height="50" as="geometry"/></mxCell><mxCell id="relaciones-11" value="Cancion" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Consolas;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;strokeWidth=2;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="560" y="90" width="140" height="50" as="geometry"/></mxCell><mxCell id="relaciones-12" value="" style="endArrow=none;startArrow=diamondThin;html=1;strokeColor=#333333;strokeWidth=2;endFill=0;startFill=1;endSize=10;startSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="115" as="sourcePoint"/><mxPoint x="560" y="115" as="targetPoint"/></mxGeometry></mxCell><mxCell id="relaciones-13" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Consolas;fontSize=13;fontStyle=0;fontColor=#000000;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="372" y="90" width="40" height="20" as="geometry"/></mxCell><mxCell id="relaciones-14" value="0..*" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Consolas;fontSize=13;fontStyle=0;fontColor=#000000;align=right;verticalAlign=middle;strokeWidth=1;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="506" y="90" width="50" height="20" as="geometry"/></mxCell><mxCell id="relaciones-15" value="&lt;b&gt;La clase CREA los objetos que guarda.&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot;&gt;self.__canciones[...] = Cancion(titulo, ...)&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;fontColor=#000000;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="720" y="86" width="390" height="60" as="geometry"/></mxCell><mxCell id="relaciones-16" value="Agregación" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#000000;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="0" y="180" width="150" height="50" as="geometry"/></mxCell><mxCell id="relaciones-17" value="CajaRegistradora" styl