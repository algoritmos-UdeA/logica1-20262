rokeColor=none;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;fontColor=#000000;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="720" y="176" width="390" height="60" as="geometry"/></mxCell><mxCell id="relaciones-23" value="¿Quién crea el objeto? Si lo crea la clase que lo guarda: composición. Si lo recibe ya creado: agregación." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="0" y="270" width="1110" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>